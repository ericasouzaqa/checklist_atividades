{
  "name": "checklist-diario-erica",
  "version": "1.0.0",
  "description": "Widget de checklist flutuante offline minimalista e reativo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:portable": "electron-builder --win"
  },
  "keywords": [],
  "author": "Erica",
  "license": "ISC",
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.erica.checklistdiario",
    "productName": "ChecklistDiario",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "ChecklistDiario_Portatil.${ext}",
      "splashImage": null,
      "requestExecutionLevel": "user"
    },
    "asar": true,
    "includeSubNodeModules": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "icon.ico"
    ]
  }
}
